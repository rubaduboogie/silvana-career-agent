[Unit]
Description=Silvana Career Agent
After=network.target
[Service]
Type=simple
User=career-agent
Group=career-agent
WorkingDirectory=/opt/career-agent-src
EnvironmentFile=/opt/career-agent-src/.env
ExecStart=/opt/career-agent-src/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target

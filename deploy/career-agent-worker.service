[Unit]
Description=Silvana Career Agent Background Search and Response Preparation
After=network-online.target career-browser.service career-agent.service
Wants=network-online.target
Requires=career-browser.service

[Service]
Type=oneshot
User=career-agent
Group=career-agent
WorkingDirectory=/opt/career-agent-src
EnvironmentFile=-/opt/career-agent-src/.env
ExecStart=/opt/career-agent-src/.venv/bin/python -m app.worker
TimeoutStartSec=30min
Nice=10

[Install]
WantedBy=multi-user.target
